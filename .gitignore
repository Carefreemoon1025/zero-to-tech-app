# 依赖
node_modules/

# npm 缓存（本沙箱的家目录只读，缓存改放在项目内）
.npm-cache/

# Next.js 构建产物
.next/
out/
dist/

# 环境变量（本地/生产各不相同，一律不进版本库）
.env
.env.local
.env*.local

# 日志与临时文件
*.log
npm-debug.log*
.DS_Store

# Python
__pycache__/
*.pyc
.venv/
venv/

# 数据库文件（SQLite，运行时生成）
*.db
*.sqlite3

# 本地引导用的临时目录（下载的 deb、解包出的 pip）
.tmp-bootstrap/

# 端到端验证用的无头浏览器用户目录
.tmp-chrome*/
